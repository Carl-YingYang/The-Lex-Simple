# Lex-Simple Backend environment variables
# Kopyahin ito bilang ".env" tapos punan ang totoong values.
# HUWAG i-commit ang totoong .env file (nasa .gitignore na siya).

# --- REQUIRED (hindi magsi-start ang server kapag kulang, tingnan ang main.py) ---
GROQ_API_KEY=
ADMIN_API_KEY=

# --- Optional: OCR / knowledge import (defaults sa services/knowledge_catalog.py) ---
# Path ng Tesseract.exe sa Windows, hal.: C:\Program Files\Tesseract-OCR\tesseract.exe
# Kapag walang laman, tatawagin lang ang "tesseract" mula sa PATH.
TESSERACT_CMD=
# Saan naka-save ang mga PDF/docx na i-iimport. Default: ./knowledge_files
KNOWLEDGE_FILES_DIR=
# Max na laki ng upload sa /simplify_file, sa MB. Default: 15
MAX_UPLOAD_MB=15

# --- Optional: rate limiting (defaults sa core/rate_limit.py) ---
RATE_LIMIT_AI=10/minute;100/hour
RATE_LIMIT_CHAT=20/minute;300/hour
RATE_LIMIT_FEEDBACK=3/minute;10/hour
RATE_LIMIT_IP_CEILING=60/minute

# --- Optional: model overrides (defaults sa services/llm_config.py) ---
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_EXTRACT_MODEL=openai/gpt-oss-120b
GROQ_EXPLAIN_MODEL=openai/gpt-oss-120b